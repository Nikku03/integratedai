# Copy to .env and adjust. Every value has a safe default for local development.
CIE_DATABASE_URL=postgresql+psycopg://cie:cie@localhost:5432/cie
CIE_VAULT_BACKEND=local            # local | s3
CIE_VAULT_PATH=./.cie_data/vault
CIE_S3_ENDPOINT=http://localhost:9000
CIE_S3_BUCKET=cie-vault
CIE_S3_ACCESS_KEY=minioadmin
CIE_S3_SECRET_KEY=minioadmin
CIE_EMBEDDING_PROVIDER=fastembed   # fastembed | hashed | openai
CIE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CIE_EMBEDDING_DIM=384
CIE_MODEL_CACHE=./.models
CIE_LLM_PROVIDER=none              # none | anthropic | openai | gemini | local
CIE_LLM_MODEL=claude-sonnet-5
CIE_OCR_BACKEND=auto               # auto | pymupdf | tesseract | unlimited_ocr
CIE_UNLIMITED_OCR_URL=             # OpenAI-compatible vLLM/SGLang endpoint, e.g. http://ocr:10000
CIE_REDIS_URL=redis://localhost:6379/0
CIE_ENCRYPTION_KEY=                # 32-byte base64 key for vault encryption at rest (optional)
CIE_LOG_LEVEL=INFO
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
